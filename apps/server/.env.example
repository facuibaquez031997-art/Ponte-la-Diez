# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ponte_la_10?schema=public"

# Auth (Fase 1)
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# Mercado Pago (Fase 3)
MP_ACCESS_TOKEN=
