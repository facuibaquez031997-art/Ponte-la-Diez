# Web Push (Fase 4)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ponte-la-10.local

# IA (Fase 0: adaptadores preparados, sin dependencia instalada)
ENGRAM_ENABLED=false
ENGRAM_URL=
GENTLE_AI_ENABLED=false
