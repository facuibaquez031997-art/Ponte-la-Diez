datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PLAYER
  OWNER
}

enum Posicion {
  ARQUERO
  DEFENSOR
  MEDIOCAMPISTA
  DELANTERO
  TODOS
}

enum Alcance {
  BARRIO
  CONTACTOS
}

enum RespuestaEstado {
  ACEPTADA
  DECLINADA
}

enum ContactoEstado {
  PENDIENTE
  ACEPTADO
}

enum TurnoState {
  FREE
  RESERVED
  BLOCKED
}

enum ReservaState {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentState {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String                  @id @default(uuid())
  nombre             String
  email              String                  @unique
  passwordHash       String
  rol                Role                    @default(PLAYER)
  telefono           String?
  barrioPontevedra   String?
  avatarUrl          String?
  createdAt          DateTime                @default(now())
  canchas            Cancha[]                @relation("OwnerCanchas")
  reservas           Reserva[]
  convocatorias      Convocatoria[]
  subscriptions      PushSubscription[]
  notificaciones     Notificacion[]
  respuestas         RespuestaConvocatoria[]
  contactosEnviados  Contacto[]              @relation("ContactosEnviados")
  contactosRecibidos Contacto[]              @relation("ContactosRecibidos")
}

model Contacto {
  id             String         @id @default(uuid())
  solicitanteId  String
  solicitante    User           @relation("ContactosEnviados", fields: [solicitanteId], references: [id])
  destinatarioId String
  destinatario   User           @relation("ContactosRecibidos", fields: [destinatarioId], references: [id])
  estado         ContactoEstado @default(PENDIENTE)
  createdAt      DateTime       @default(now())

  @@unique([solicitanteId, destinatarioId])
  @@index([destinatarioId, estado])
}

model Cancha {
  id             String         @id @default(uuid())
  ownerId        String
  owner          User           @relation("OwnerCanchas", fields: [ownerId], references: [id])
  nombre         String
  direccion      String
  tipoSuperficie String
  precioHora     Float
  montoSena      Float
  turnos         Turno[]
  convocatorias  Convocatoria[]
}

model Turno {
  id              String     @id @default(uuid())
  canchaId        String
  cancha          Cancha     @relation(fields: [canchaId], references: [id])
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  estado          TurnoState @default(FREE)
  reserva         Reserva?
}

model Reserva {
  id         String       @id @default(uuid())
  turnoId    String       @unique
  turno      Turno        @relation(fields: [turnoId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  estado     ReservaState @default(PENDING)
  montoTotal Float
  pago       Pago?
}

model Pago {
  id             String       @id @default(uuid())
  reservaId      String       @unique
  reserva        Reserva      @relation(fields: [reservaId], references: [id])
  mpPreferenceId String?
  mpPaymentId    String?
  estadoPago     PaymentState @default(PENDING)
  monto          Float
}

model Convocatoria {
  id                 String                  @id @default(uuid())
  creadorId          String
  creador            User                    @relation(fields: [creadorId], references: [id])
  canchaId           String?
  cancha             Cancha?                 @relation(fields: [canchaId], references: [id])
  canchaNombre       String?
  fechaHora          DateTime
  jugadoresFaltantes Int
  posicion           Posicion
  mensaje            String?
  alcance            Alcance                 @default(BARRIO)
  estado             String                  @default("ABIERTA")
  notificaciones     Notificacion[]
  respuestas         RespuestaConvocatoria[]
}

model RespuestaConvocatoria {
  id             String          @id @default(uuid())
  convocatoriaId String
  convocatoria   Convocatoria    @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  estado         RespuestaEstado
  createdAt      DateTime        @default(now())

  @@unique([convocatoriaId, userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keysP256  String
  keysAuth  String
  createdAt DateTime @default(now())
}

model Notificacion {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  convocatoriaId String?
  convocatoria   Convocatoria? @relation(fields: [convocatoriaId], references: [id], onDelete: SetNull)
  titulo         String
  cuerpo         String
  leida          Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([userId, leida])
}
