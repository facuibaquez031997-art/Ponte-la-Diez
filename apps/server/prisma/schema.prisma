datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PLAYER
  OWNER
}

enum Posicion {
  ARQUERO
  DEFENSOR
  MEDIOCAMPISTA
  DELANTERO
  TODOS
}

enum Alcance {
  BARRIO
  CONTACTOS
}

enum RespuestaEstado {
  ACEPTADA
  DECLINADA
}

enum ContactoEstado {
  PENDIENTE
  ACEPTADO
}

enum TurnoState {
  FREE
  RESERVED
  BLOCKED
}

enum ReservaState {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentState {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String                  @id @default(uuid())
  nombre             String
  email              String                  @unique
  passwordHash       String
  rol                Role                    @default(PLAYER)
  telefono           String?
  barrioPontevedra   String?
  avatarUrl          String?
  createdAt          DateTime                @default(now())
  canchas            Cancha[]                @relation("OwnerCanchas")
  reservas           Reserva[]
  convocatorias      Convocatoria[]
  subscriptions      PushSubscription[]
  notificaciones     Notificacion[]
  respuestas         RespuestaConvocatoria[]
  contactosEnviados  Contacto[]              @relation("ContactosEnviados")
  contactosRecibidos Contacto[]              @relation("ContactosRecibidos")
  historialReservas  HistorialReserva[]
  conversaciones     Conversacion[]
  mensajes           Mensaje[]
}

model Contacto {
  id             String         @id @default(uuid())
  solicitanteId  String
  solicitante    User           @relation("ContactosEnviados", fields: [solicitanteId], references: [id])
  destinatarioId String
  destinatario   User           @relation("ContactosRecibidos", fields: [destinatarioId], references: [id])
  estado         ContactoEstado @default(PENDIENTE)
  createdAt      DateTime       @default(now())

  @@unique([solicitanteId, destinatarioId])
  @@index([destinatarioId, estado])
}

model Cancha {
  id             String             @id @default(uuid())
  ownerId        String
  owner          User               @relation("OwnerCanchas", fields: [ownerId], references: [id])
  nombre         String
  direccion      String
  barrio         String
  tipoSuperficie String
  // Players per side: 5, 7, 9 or 11. Courts created before it existed have none until the owner sets it.
  jugadores      Int?
  // How many courts of this size the owner has: that many slots exist at the same hour.
  cantidad       Int                @default(1)
  precioHora     Float
  montoSena      Float
  turnos         Turno[]
  horarios       HorarioCancha[]
  fotos          CanchaFoto[]
  convocatorias  Convocatoria[]
  historial      HistorialReserva[]
  conversaciones Conversacion[]
  // The entries that use the same physical space as this one (booking one blocks the other at
  // that hour). Stored in both directions, so each entry finds its own links.
  comparteCon    CanchaConflicto[]  @relation("CanchaConflictos")
  comparteDe     CanchaConflicto[]  @relation("CanchaConflictosDe")
}

model CanchaConflicto {
  canchaId     String
  cancha       Cancha @relation("CanchaConflictos", fields: [canchaId], references: [id], onDelete: Cascade)
  otraCanchaId String
  otraCancha   Cancha @relation("CanchaConflictosDe", fields: [otraCanchaId], references: [id], onDelete: Cascade)

  @@id([canchaId, otraCanchaId])
  @@index([otraCanchaId])
}

model CanchaFoto {
  id        String   @id @default(uuid())
  canchaId  String
  cancha    Cancha   @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  publicId  String   @unique
  url       String
  createdAt DateTime @default(now())

  @@index([canchaId, createdAt])
}

model HorarioCancha {
  id           String @id @default(uuid())
  canchaId     String
  cancha       Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  diaSemana    Int
  minutoInicio Int
  minutoFin    Int

  @@index([canchaId, diaSemana])
}

model Turno {
  id              String     @id @default(uuid())
  canchaId        String
  cancha          Cancha     @relation(fields: [canchaId], references: [id])
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  estado          TurnoState @default(FREE)
  // Which of the courts of the entry this slot is (1 to cantidad).
  numero          Int        @default(1)
  reserva         Reserva?

  @@unique([canchaId, fechaHoraInicio, numero])
}

model Reserva {
  id             String         @id @default(uuid())
  turnoId        String         @unique
  turno          Turno          @relation(fields: [turnoId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  estado         ReservaState   @default(PENDING)
  montoTotal     Float
  createdAt      DateTime       @default(now())
  pago           Pago?
  notificaciones Notificacion[]
  conversacion   Conversacion?
}

model Pago {
  id             String       @id @default(uuid())
  reservaId      String       @unique
  reserva        Reserva      @relation(fields: [reservaId], references: [id])
  mpPreferenceId String?
  mpPaymentId    String?
  estadoPago     PaymentState @default(PENDING)
  monto          Float
}

model Convocatoria {
  id                 String                  @id @default(uuid())
  creadorId          String
  creador            User                    @relation(fields: [creadorId], references: [id])
  canchaId           String?
  cancha             Cancha?                 @relation(fields: [canchaId], references: [id])
  canchaNombre       String?
  fechaHora          DateTime
  jugadoresFaltantes Int
  posicion           Posicion
  mensaje            String?
  alcance            Alcance                 @default(BARRIO)
  estado             String                  @default("ABIERTA")
  notificaciones     Notificacion[]
  respuestas         RespuestaConvocatoria[]
}

model RespuestaConvocatoria {
  id             String          @id @default(uuid())
  convocatoriaId String
  convocatoria   Convocatoria    @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  estado         RespuestaEstado
  createdAt      DateTime        @default(now())

  @@unique([convocatoriaId, userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keysP256  String
  keysAuth  String
  createdAt DateTime @default(now())
}

model Notificacion {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  convocatoriaId String?
  convocatoria   Convocatoria? @relation(fields: [convocatoriaId], references: [id], onDelete: SetNull)
  reservaId      String?
  reserva        Reserva?      @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  conversacionId String?
  conversacion   Conversacion? @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  titulo         String
  cuerpo         String
  // Screen the notification opens. Older notifications have none and use the old rules.
  url            String?
  leida          Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([userId, leida])
}

enum MotivoCierre {
  VENCIDA
  CANCELADA_DUENO
}

enum EstadoDevolucion {
  NO_CORRESPONDE
  PENDIENTE
  HECHA
}

// A booking that stopped existing (unpaid and expired, or cancelled by the owner). The booking
// itself is deleted so its slot can be booked again (Reserva.turnoId is unique); this keeps what
// the owner needs to follow earnings, attendance and refunds.
model HistorialReserva {
  id          String           @id @default(uuid())
  canchaId    String
  cancha      Cancha           @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  jugadorId   String
  jugador     User             @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  turnoInicio DateTime
  turnoFin    DateTime
  montoTotal  Float
  montoPagado Float            @default(0)
  mpPaymentId String?
  motivo      MotivoCierre
  devolucion  EstadoDevolucion
  devueltoAt  DateTime?
  reservadaAt DateTime
  cerradaAt   DateTime         @default(now())

  @@index([canchaId, cerradaAt])
}

model Conversacion {
  id               String         @id @default(uuid())
  reservaId        String?        @unique
  reserva          Reserva?       @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  canchaId         String
  cancha           Cancha         @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  jugadorId        String
  jugador          User           @relation(fields: [jugadorId], references: [id])
  turnoInicio      DateTime?
  jugadorLeyoHasta DateTime?
  duenoLeyoHasta   DateTime?
  jugadorEliminoAt DateTime?
  duenoEliminoAt   DateTime?
  ultimoMensajeAt  DateTime?
  createdAt        DateTime       @default(now())
  mensajes         Mensaje[]
  notificaciones   Notificacion[]

  @@index([jugadorId, ultimoMensajeAt])
  @@index([canchaId, ultimoMensajeAt])
}

model Mensaje {
  id             String       @id @default(uuid())
  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autorId        String
  autor          User         @relation(fields: [autorId], references: [id])
  cuerpo         String
  // Slot the owner offers with this message. Plain columns, no foreign key: free slots are deleted
  // and regenerated with the weekly schedule and an offer must never block that.
  ofertaTurnoId  String?
  ofertaInicio   DateTime?
  // Court of the offered slot: the owner may offer a slot of any of their courts.
  ofertaCanchaId String?
  createdAt      DateTime     @default(now())

  @@index([conversacionId, createdAt])
}
