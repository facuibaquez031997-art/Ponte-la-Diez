{
  "name": "ponte-la-10",
  "private": true,
  "version": "0.1.0",
  "description": "Ponte la 10: reservas de canchas de fútbol en Pontevedra",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run start:dev -w apps/server",
    "dev:client": "npm run dev -w apps/client",
    "build": "npm run build -w apps/server && npm run build -w apps/client",
    "lint": "npm run lint -w apps/server && npm run lint -w apps/client",
    "test": "npm run test -w apps/server",
    "db:generate": "npm run prisma:generate -w apps/server",
    "db:migrate": "npm run prisma:migrate -w apps/server",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/client/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "apps/server/**/*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  }
}
